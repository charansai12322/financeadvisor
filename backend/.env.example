# ==============================================================================
# Finance Advisor Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Gemini AI API Key (Obtain from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Configured Gemini Model Identifier
GEMINI_MODEL=gemini-3.5-flash

# Upstream Market Data API Base URL
GOLD_API_BASE_URL=https://api.gold-api.com

# Application Server Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Allowed Origins (Comma-separated list, e.g. for local frontend or deployed Vercel domain)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# General Upstream Request Timeout (seconds)
REQUEST_TIMEOUT_SECONDS=10

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Chroma Vector Store Persistence Directory & Collection
CHROMA_PERSIST_DIRECTORY=./chroma_langchain_db
CHROMA_COLLECTION_NAME=finance_docs

# Reference Document Storage Directory
PDF_STORAGE_DIR=./data/pdfs
